q BT/F3 9 Tf 295.3878 31.1811 TD (3)Tj ET q 1 0 0 1 56.69291 769.1969 cm 0 0 0 RG 0 1.375 m 72.93 1.375 l S 0 0 0 rg BT/F2 13 Tf 0 3 TD (PROGRAM:)Tj ET Q q 1 0 0 1 56.69291 208.9969 cm 1 1 1 rg 0 0 0 RG .8 w 0 0 481.8898 554.2 re B* 0 539.2 481.8898 15 re f* 0 539.2 m 481.8898 539.2 l S 0 0 0 rg BT/F6 8.5 Tf 8 543.7 TD (myping.py)Tj ET BT/F4 7.8 Tf 6 528.8 TD (# Own ping program using RAW sockets \(ICMP\) - run as root)Tj ET BT/F4 7.8 Tf 6 519 TD (import socket, struct, time, sys, os)Tj ET BT/F4 7.8 Tf 6 499.4 TD (def checksum\(data\):)Tj ET BT/F4 7.8 Tf 6 489.6 TD (    if len\(data\) % 2:)Tj ET BT/F4 7.8 Tf 6 479.8 TD (        data += b'\\x00')Tj ET BT/F4 7.8 Tf 6 470 TD (    s = sum\(struct.unpack\("!%dH" % \(len\(data\) // 2\), data\)\))Tj ET BT/F4 7.8 Tf 6 460.2 TD (    s = \(s >> 16\) + \(s & 0xffff\))Tj ET BT/F4 7.8 Tf 6 450.4 TD (    s += s >> 16)Tj ET BT/F4 7.8 Tf 6 440.6 TD (    return ~s & 0xffff)Tj ET BT/F4 7.8 Tf 6 421 TD (def make_packet\(seq, pid\):)Tj ET BT/F4 7.8 Tf 6 411.2 TD (    header = struct.pack\("!BBHHH", 8, 0, 0, pid, seq\)      # type 8 = echo request)Tj ET BT/F4 7.8 Tf 6 401.4 TD (    payload = struct.pack\("!d", time.time\(\)\) + b"abcdefghijklmnop")Tj ET BT/F4 7.8 Tf 6 391.6 TD (    chk = checksum\(header + payload\))Tj ET BT/F4 7.8 Tf 6 381.8 TD (    header = struct.pack\("!BBHHH", 8, 0, chk, pid, seq\))Tj ET BT/F4 7.8 Tf 6 372 TD (    return header + payload)Tj ET BT/F4 7.8 Tf 6 352.4 TD (def ping\(host, count=4\):)Tj ET BT/F4 7.8 Tf 6 342.6 TD (    try:)Tj ET BT/F4 7.8 Tf 6 332.8 TD (        ip = socket.gethostbyname\(host\))Tj ET BT/F4 7.8 Tf 6 323 TD (    except socket.gaierror:)Tj ET BT/F4 7.8 Tf 6 313.2 TD (        print\(f"ping: {host}: Name or service not known"\))Tj ET BT/F4 7.8 Tf 6 303.4 TD (        return)Tj ET BT/F4 7.8 Tf 6 293.6 TD (    s = socket.socket\(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_ICMP\))Tj ET BT/F4 7.8 Tf 6 283.8 TD (    s.settimeout\(2\))Tj ET BT/F4 7.8 Tf 6 274 TD (    pid = os.getpid\(\) & 0xffff)Tj ET BT/F4 7.8 Tf 6 264.2 TD (    print\(f"PING {host} \({ip}\) 32 bytes of data."\))Tj ET BT/F4 7.8 Tf 6 254.4 TD (    times = [])Tj ET BT/F4 7.8 Tf 6 244.6 TD (    for seq in range\(1, count + 1\):)Tj ET BT/F4 7.8 Tf 6 234.8 TD (        s.sendto\(make_packet\(seq, pid\), \(ip, 0\)\))Tj ET BT/F4 7.8 Tf 6 225 TD (        t1 = time.time\(\))Tj ET BT/F4 7.8 Tf 6 215.2 TD (        try:)Tj ET BT/F4 7.8 Tf 6 205.4 TD (            while True:)Tj ET BT/F4 7.8 Tf 6 195.6 TD (                data, addr = s.recvfrom\(1024\))Tj ET BT/F4 7.8 Tf 6 185.8 TD (                typ, code, _, rid, rseq = struct.unpack\("!BBHHH", data[20:28]\))Tj ET BT/F4 7.8 Tf 6 176 TD (                if typ == 0 and rid == pid:)Tj ET BT/F4 7.8 Tf 6 166.2 TD (                    break)Tj ET BT/F4 7.8 Tf 6 156.4 TD (            rtt = \(time.time\(\) - t1\) * 1000)Tj ET BT/F4 7.8 Tf 6 146.6 TD (            ttl = data[8])Tj ET BT/F4 7.8 Tf 6 136.8 TD (            times.append\(rtt\))Tj ET BT/F4 7.8 Tf 6 127 TD (            print\(f"{len\(data\)-20} bytes from {addr[0]}: icmp_seq={rseq} ttl={ttl} time={rtt:.3f} ms)Tj ET BT/F4 7.8 Tf 6 117.2 TD (              "\))Tj ET BT/F4 7.8 Tf 6 107.4 TD (        except socket.timeout:)Tj ET BT/F4 7.8 Tf 6 97.6 TD (            print\(f"Request timed out for icmp_seq={seq}"\))Tj ET BT/F4 7.8 Tf 6 87.8 TD (        time.sleep\(1\))Tj ET BT/F4 7.8 Tf 6 78 TD (    s.close\(\))Tj ET BT/F4 7.8 Tf 6 68.2 TD (    lost = count - len\(times\))Tj ET BT/F4 7.8 Tf 6 58.4 TD (    print\(f"\\n--- {host} ping statistics ---"\))Tj ET BT/F4 7.8 Tf 6 48.6 TD (    print\(f"{count} packets transmitted, {len\(times\)} received, {lost*100//count}% packet loss"\))Tj ET BT/F4 7.8 Tf 6 38.8 TD (    if times:)Tj ET BT/F4 7.8 Tf 6 29 TD (        print\(f"rtt min/avg/max = {min\(times\):.3f}/{sum\(times\)/len\(times\):.3f}/{max\(times\):.3f} ms"\))Tj ET BT/F4 7.8 Tf 6 9.4 TD (ping\(sys.argv[1] if len\(sys.argv\) > 1 else "127.0.0.1"\))Tj ET Q Q

